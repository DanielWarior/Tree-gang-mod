[core]
#so you can't see with unfinished shit
armour:0
fogOfWarSightRangeWhileNotBuilt:2
autoTriggerCooldownTime: 0.2s
@memory stunDebuff:number
@memory DjinTarget:unit
@memory captureValue:number
@memory captureParent:unit
@memory originalTeam:number
@memory freedomTime:number
@memory costValue:number
@memory aiBehaviourTimer:number

#Sets the memory for unit cost and other things if needed
[hiddenAction_instantiate]
autoTriggerOnEvent: created
setUnitMemory: costValue = self.priceCredits()


#Attackable Type Block ---{

[hiddenAction_UnitAttackableTypeLand]
autoTriggerCheckRate:every8Frames
autoTrigger:if not self.hasTags(includes="land")
requireConditional: if (self.height() >= 0 and self.height() <= 3.5 )  or "${movement.movementType}" !="AIR"
temporarilyAddTags:land
temporarilyRemoveTags:air, sub

[hiddenAction_UnitAttackableTypeAir]
autoTriggerCheckRate:every8Frames
autoTrigger:if not self.hasTags(includes="air")
requireConditional: if (self.height() >= 3.5 )  and "${movement.movementType}" =="AIR"
temporarilyAddTags:air
temporarilyRemoveTags:land, sub

[hiddenAction_UnitAttackableTypeSub]
autoTriggerCheckRate:every8Frames
autoTrigger:if not self.hasTags(includes="sub")
requireConditional: if self.height() < 0 
temporarilyAddTags:sub
temporarilyRemoveTags:air, land

#Attackable Type Block }---


#AI block ---{

[hiddenAction_AiInstantiate]
autoTriggerOnEvent: created
requireConditional:if self.isControlledByAI()
temporarilyAddTags: aiControlled, active
setUnitMemory:aiBehaviourTimer=self.timeAlive()

#AI targeting Block ---{{

[hiddenAction_AiCheckTargetingLand]
autoTriggerCheckRate:every8Frames
autoTrigger:if self.lastConverted() < 5 or not self.hasTags(includes="shootsLand")
requireConditional:if "${attack.canAttackLandUnits}" != "false"
temporarilyAddTags:shootsLand

[hiddenAction_AiCheckTargetingAir]
autoTriggerCheckRate:every8Frames
autoTrigger:if self.lastConverted() < 5 or not self.hasTags(includes="shootsAir")
requireConditional:if "${attack.canAttackFlyingUnits}" != "false"
temporarilyAddTags:shootsAir

[hiddenAction_AiCheckTargetingSub]
autoTriggerCheckRate:every8Frames
autoTrigger:if self.lastConverted() < 5 or not self.hasTags(includes="shootsSub")
requireConditional:if "${attack.canAttackUnderwaterUnits}" != "false"
temporarilyAddTags:shootsSub

#AI targeting Block }}---

[action_AiBehaviourSwitchOff]
text:AI main behaviour OFF
isVisible:if self.hasTags(includes="aiControlled") and not self.hasTags(includes="aiControlledOff") 
ai_isDisabled:true
temporarilyAddTags: aiControlledOff

[action_AiBehaviourSwitchOn]
text:AI main behaviour ON
isVisible:if self.hasTags(includes="aiControlled") and self.hasTags(includes="aiControlledOff") 
ai_isDisabled:true
temporarilyRemoveTags: aiControlledOff

#AI targeting Behaviour Block ---{{

#add the notCombatUnit tag to units you do not want affected by this

[hiddenAction_attackBehaviourLand]
buildSpeed:1s
autoTriggerCheckRate:every8Frames
autoTrigger:if (self.hasTags(includes="aiControlled") and self.hasTags(includes="shootsLand") and not self.hasTags(includes="aiControlledOff")) and not self.hasTags(includes="notCombatUnit")
requireConditional:if self.hasTags(includes="active") and self.timeAlive() > memory.aiBehaviourTimer + 15

setUnitMemory:aiBehaviourTimer=self.timeAlive()

addWaypoint_type:attackMove
clearActiveWaypoint:false
addWaypoint_prepend:true
addWaypoint_maxTime:30s
addWaypoint_target_nearestUnit_team:enemy
addWaypoint_target_mapMustBeReachable:true
addWaypoint_target_nearestUnit_tagged:land

[hiddenAction_attackBehaviourAir]
buildSpeed:1s
autoTriggerCheckRate:every8Frames
autoTrigger:if (self.hasTags(includes="aiControlled") and self.hasTags(includes="shootsAir") and not self.hasTags(includes="aiControlledOff")) and not self.hasTags(includes="notCombatUnit")
requireConditional:if self.hasTags(includes="active") and self.timeAlive() > memory.aiBehaviourTimer + 15

setUnitMemory:aiBehaviourTimer=self.timeAlive()

addWaypoint_type:attackMove
clearActiveWaypoint:false
addWaypoint_prepend:true
addWaypoint_maxTime:30s
addWaypoint_target_nearestUnit_team:enemy
addWaypoint_target_mapMustBeReachable:true
addWaypoint_target_nearestUnit_tagged:air

[hiddenAction_attackBehaviourSub]
buildSpeed:1s
autoTriggerCheckRate:every8Frames
autoTrigger:if (self.hasTags(includes="aiControlled") and self.hasTags(includes="shootsSub") and not self.hasTags(includes="aiControlledOff")) and not self.hasTags(includes="notCombatUnit")
requireConditional:if self.hasTags(includes="active") and self.timeAlive() > memory.aiBehaviourTimer + 15

setUnitMemory:aiBehaviourTimer=self.timeAlive()

addWaypoint_type:attackMove
clearActiveWaypoint:false
addWaypoint_prepend:true
addWaypoint_maxTime:30s
addWaypoint_target_nearestUnit_team:enemy
addWaypoint_target_mapMustBeReachable:true
addWaypoint_target_nearestUnit_tagged:sub

#AI targeting Behaviour Block }}---

#Maybe make a cost counter block in the future, but unlikelly, cause rusted jank is one gorillion percent gonna ruin it lol

#AI block }---

#shieldBuilding tag adder
[hiddenAction_shieldtag]
autoTriggerOnEvent: created
requireConditional:if self.hasTags(includes="building") and self.maxShield > 0
temporarilyAddTags: shieldBuilding

[hiddenAction_gettingtargeted]
autoTriggerOnEvent: tookDamage(withTag='targethangar')
temporarilyAddTags: targethangar



[hiddenAction_stopgettingtargeted]
autoTrigger: if not self.numberOfUnitsInEnemyTeam(withTag='hangar1', withinRange=1000, greaterThan=0)
temporarilyRemoveTags: targethangar

[attack]
canAttackFlyingUnits: if not self.hasParent(withTag='gunOff')
canAttackLandUnits: if not self.hasParent(withTag='gunOff')
canAttackUnderwaterUnits: if not self.hasParent(withTag='gunOff')

[hiddenAction_rember]
autoTriggerOnEvent: created
setUnitMemory: originalTeam = self.teamId

[hiddenAction_turnOffGun]
autoTrigger: if self.hasParent
temporarilyAddTags:gunOff

[hiddenAction_turnOnGun]
autoTrigger: if not self.hasParent
temporarilyRemoveTags:gunOff



#--- blehhh i capture your nuts
[hiddenAction_bahaCaptureValue]
autoTriggerOnEvent: tookDamage(withTag="baha")
setUnitMemory: captureValue = memory.captureValue + 10
alsoTriggerAction: capturing
alsoTriggerOrQueueActionConditional: if (memory.captureValue >= (self.hp + self.shield)/2) and lastDamagedBy.tags(includes='capturer')



[hiddenAction_capturing]
#might cause issues, since it does not filter for baha
#ahem it won't, because it only sends a message, which the baha unit currently is the only one that responds to it
sendMessageTo: lastDamagedBy
sendMessageWithTags: capturing
debugMessage: [action log] %{self} is getting captured by %{memory.captureParent}



[hiddenAction_captured]
autoTriggerOnEvent: newMessage(withTag="captured")
setUnitMemory: captureParent = eventSource
switchToTeam: eventSource.teamId
setUnitMemory:captureValue = 0, freedomTime = self.timeAlive()

[hiddenAction_freedom]
autoTriggerOnEvent: newMessage(withTag="uncaptured")
switchToTeam: memory.originalTeam
debugMessage: [action log] %{self} has been uncaptured


[hiddenAction_freedomTimed]
autoTrigger:if (self.timeAlive() > (memory.freedomTime + 30)) and not (memory.freedomTime == 0)
switchToTeam: memory.originalTeam
debugMessage: [action log] %{self} has been uncaptured
setUnitMemory: freedomTime = 0

[hiddenAction_lossCaptureValue]
autoTrigger: if self.hasTakenDamage(laterThanSeconds=1) and not (memory.captureValue < 0)
setUnitMemory: captureValue= memory.captureValue-20



[decal_captureAmount]
#isVisible:if not self.hasTags(includes="captured")
image:ROOT:shared\graphics\captureOrb.png
alpha: memory.captureValue / ((self.hp + self.shield)/2)
onlyWhileAlive:true

[decal_captureTimer]
isVisible:if memory.freedomTime != 0
image:ROOT:shared\graphics\captureIndicator.png

#normalizing the value math
alpha: ( (memory.freedomTime + 30) - self.timeAlive() ) / 30

onlyWhileAlive:true
#---

[global_resource_crystal]
displayName: Crystals
displayNameShort: Mi
hidden:false
displayWhenZero: false
displayColor:#ff3795
displayTextPrefix: Crystal:  
displayNameHideWhenIconShownInText: true
displayNameHideWhenIconShownInHUD: true
iconImage: ROOT:shared\graphics\ocua_core_slot00.png

[hiddenAction_hitstunTimer]
autoTriggerOnEvent: tookdamage(withTag="stun")
requireConditional: if not self.tags(includes="iamstunned") and not self.tags(includes="idontlikestuns") and not self.tags(includes="50k") and memory.stunDebuff < 1
setUnitMemory: stunDebuff = 5

[hiddenAction_hitstunDebuff]
autoTriggerOnEvent: tookDamage(withTag="stun")
requireConditional: if not self.tags(includes="iamstunned") and not self.tags(includes="idontlikestuns") and not self.tags(includes="50k")
setUnitStats: moveSpeed = 0, maxAttackRange = 0
temporarilyAddTags: iamstunned

[hiddenAction_decrementStunDebuff]
autoTrigger: if memory.stunDebuff > 0
setUnitMemory: stunDebuff = memory.stunDebuff -1

[hiddenAction_stunDebuffDeactivate]
autoTrigger: if memory.stunDebuff == 0
requireConditional: if self.tags(includes="iamstunned")
resetUnitStats: true
temporarilyRemoveTags: iamstunned

[hiddenAction_hitbigstunTimer]
autoTriggerOnEvent: tookdamage(withTag="bigstun")
requireConditional: if not self.tags(includes="iamstunned") and not self.tags(includes="idontlikestuns") and not self.tags(includes="50k") and memory.stunDebuff < 1
setUnitMemory: stunDebuff = 10

[hiddenAction_hitbigstunDebuff]
autoTriggerOnEvent: tookDamage(withTag="bigstun")
requireConditional: if not self.tags(includes="iamstunned") and not self.tags(includes="idontlikestuns") and not self.tags(includes="50k")
setUnitStats: moveSpeed = 0, maxAttackRange = 0
temporarilyAddTags: iamstunned

[hiddenAction_slow]
autoTriggerOnEvent: tookdamage(withTag="slow")
setUnitStats:moveSpeed=${movement.moveSpeed}/1.4 - 0.1
resetCustomTimer:true
temporarilyAddTags:slowed

[hiddenAction_slowRemove]
autoTrigger: if self.customTimer(laterThanSeconds=2) and self.hasTags(includes="slowed")
temporarilyRemoveTags:slowed
setUnitStats:moveSpeed = ${movement.moveSpeed}
autoTriggerCheckRate:every8Frames

#required to include base stats to make ${section.parameter} work
[movement]
moveSpeed:1

#----
[hiddenAction_spongeShieldCheck]
autoTriggerCheckRate:everyFrame
autoTrigger:if not self.hasTags(includes="amsponge") and self.shield() < self.maxShield() and self.hasTags(includes="underSponge")
addResources:shield=+50
setCustomTarget2:nearestUnit(withinRange=300, withTag="sponge",relation="ally")
sendMessageTo: customTarget2
sendMessageWithTags:deplete

[hiddenAction_spongeShieldAddTag]
autoTrigger:if numberOfUnitsInTeam(withTag='sponge', greaterThan=0, withinRange=300) and not self.hasTags(includes="amsponge")
temporarilyAddTags:underSponge

[hiddenAction_spongeShieldRemoveTag]
autoTrigger:if numberOfUnitsInTeam(withTag='spongeEmpty', greaterThan=0, withinRange=300) and not numberOfUnitsInTeam(withTag='sponge', greaterThan=0, withinRange=300) or  not numberOfUnitsInTeam(withTag='amsponge', greaterThan=0, withinRange=300)
temporarilyRemoveTags:underSponge

[hiddenAction_spongeShieldArmourAdd]
autoTrigger:if self.hasTags(includes="underSponge")
setUnitStats:armour = ${core.armour} + 3

[hiddenAction_spongeShieldArmourRemove]
autoTrigger:if not self.hasTags(includes="underSponge")
setUnitStats:armour = ${core.armour}
#---
#Sponge shield regen script


