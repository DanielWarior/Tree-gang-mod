#djin teleporting logic
[hiddenAction_DjinTeleport0]
autoTriggerOnEvent:enteredTransport
alsoTriggerOrQueueActionConditional:if self.hasParent(withTag="beacon") 
alsoQueueAction:DjinTeleport1
buildSpeed:5
allowMultipleInQueue:false
autoTriggerCheckRate:every8Frames

[hiddenAction_DjinTeleport1]
setUnitMemory:DjinTarget = parent.readUnitMemory("teleportTarget",type="unit")
alsoQueueAction:DjinTeleport2
alsoTriggerOrQueueActionConditional:if not self.hasTags(includes="tpd")
buildSpeed:5
allowMultipleInQueue:false
autoTriggerCheckRate:every8Frames

[hiddenAction_DjinTeleport2]
alsoTriggerOrQueueActionConditional:if not self.hasTags(includes="tpd")
alsoQueueAction:DjinTeleport3
buildSpeed:5
autoTriggerCheckRate:every8Frames
allowMultipleInQueue:false

[hiddenAction_DjinTeleport3]
temporarilyAddTags:tpd
disconnectFromParent:true
teleportTo: memory.DjinTarget
buildSpeed:0.8s
allowMultipleInQueue:false
autoTriggerCheckRate:every8Frames


[hiddenAction_tpd]
autoTrigger: if self.customTimer(laterThanSeconds=4)
temporarilyRemoveTags:tpd
